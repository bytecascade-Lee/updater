# Auto detect text files and perform LF normalization
* text=auto

# Go source files
*.go text diff=golang
*.mod text
*.sum text

# Python scripts
*.py text
*.toml text

# Config & data files
*.json text
*.yaml text
*.yml text
*.md text

# Shell scripts
*.sh text eol=lf

# Makefile
Makefile text eol=lf

# Binary files
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Archive files
*.zip binary
*.tar binary
*.tar.gz binary
*.tgz binary
*.tar.zst binary
*.7z binary
*.rar binary

# Image files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.webp binary
